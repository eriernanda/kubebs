{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infra",
  "version": "0.1.0",
  "identifier": "dev.infra.kubernetes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Infra",
        "width": 1100,
        "height": 720,
        "minWidth": 920,
        "minHeight": 640,
        "decorations": false,
        "shadow": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
